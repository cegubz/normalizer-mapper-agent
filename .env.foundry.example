# Copy to .env for local container runs against the Foundry gateway.
MODEL_PROVIDER=foundry
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.ai.azure.com/api/projects/<project>
# Must match your Foundry *model deployment name* (deploy a GPT-5.6-tier model in the catalog):
OPENAI_MODEL=gpt-5.6-terra
OPENAI_ESCALATION_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=low
USE_LLM=true

# Output storage — use Azure Blob so Logic Apps can pick up the CSVs. Output container
# is derived from the input blob's own container (<x>-inbound -> <x>-outbound); OUTPUT_
# CONTAINER is only the fallback used when that can't be determined.
STORAGE_BACKEND=azure_blob
OUTPUT_CONTAINER=outputs
# Set ONE of these to authenticate against the storage account:
AZURE_STORAGE_CONNECTION_STRING=<your storage connection string>
AZURE_STORAGE_ACCOUNT_URL=<https://<account>.blob.core.windows.net>

# Auth for DefaultAzureCredential (used with AZURE_STORAGE_ACCOUNT_URL) is provided by
# the hosted agent's managed identity in Foundry; locally use `az login` or set
# AZURE_CLIENT_ID/TENANT_ID/SECRET.
