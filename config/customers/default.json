{
  "customer_id": "default",
  "description": "Default customer profile (CB MM LTP workbook). Copy _TEMPLATE.json to add a new customer.",
  "sheet_config": [
    {
      "role": "LTP",
      "target": "NEO",
      "match_patterns": [
        "ltp",
        "major component",
        "replacement schedule",
        "parts",
        "billiton"
      ],
      "__comment_filename_patterns": "Matched against a standalone reference file's basename (see REFERENCE_FILES.md), not a workbook tab — punctuation-insensitive, so 'LTP_2026_08.csv' matches 'ltp' just like 'LTP.csv' does. Add more as new naming conventions show up.",
      "filename_patterns": [
        "ltp"
      ]
    },
    {
      "role": "MEASUREMENT_POINTS",
      "target": "LAO",
      "match_patterns": [
        "measurement point",
        "measuring point",
        "meas point",
        "IK07","ik07"
      ],
      "filename_patterns": [
        "measurement points",
        "measuring points",
        "meas points",
        "ik07"
      ]
    }
  ],
  "constants": {
    "RegistrationCounter": "217040",
    "StrategyUOMCode": "H",
    "ReviewStatusCode": "Not Reviewed",
    "NewStrategyUsageValue": "",
    "LastStrategyDate": ""
  },
  "scoring": {
    "name_weight": 0.6,
    "value_weight": 0.4,
    "join_bonus": 0.15,
    "confidence_cap": 0.99,
    "bands": {
      "auto_accept": 0.9,
      "accept_review": 0.7,
      "low_review": 0.5
    },
    "min_name_gate": 0.55,
    "gate_penalty": 0.75
  },
  "normalization": {
    "join_key_canonical": "FunctionalLoc",
    "join_key_role": "MEASUREMENT_POINTS",
    "reject_rules": [
      "missing_join_key",
      "missing_identity",
      "banner_row",
      "gibberish"
    ]
  },
  "__comment_deduplication": "Keep-latest-date filter (core/deduplication.py), per target. Within each group of NEO rows sharing identical group_by field values (same task, different planned dates), only the row with the latest date_field value survives — older duplicates are removed to DuplicateDates.csv. No 'LAO' entry here deliberately: LAO has no field in this shape's schema that's actually populated with a start-date-equivalent value (its only date fields, StrategyDate/LastStrategyDate, are enrichment/constant placeholders always blank today), so the rule would be a no-op there anyway — add one if/when that changes.",
  "deduplication": {
    "NEO": {
      "group_by": [
        "AssetName",
        "ComponentCode",
        "ModifierCode",
        "TaskCounterCode"
      ],
      "date_field": "NewStrategyDate"
    }
  },
  "__comment_exclusions": "Business-rule row filter (core/exclusions.py), applied to the FINAL NEO/LAO rows (after mapping + cross-reference enrichment + ConfidenceScore), before the exception audit. A row whose `field` value contains any `keywords` entry as a case-insensitive substring is REMOVED from NEO.csv/LAO.csv and written instead to the combined ExcludedComponents.csv (tagged with which target and keyword matched) — not a data-quality decision, a business-content one.",
  "exclusions": {
    "field": "StrategyTaskDescription",
    "keywords": [
      "Hose",
      "Valve Set",
      "Harness",
      "Service Suspension",
      "Slew Bearing Inspection",
      "Coolant Engine",
      "Cooling",
      "Insp",
      "Safety",
      "Turbo",
      "clean",
      "Operators Seat",
      "Fuel",
      "Cabin",
      "Battery",
      "Batteries",
      "Air Cond",
      "Aircond",
      "Seat Belt",
      "High Risk Hose",
      "Harnesss Service",
      "Ladder"
    ]
  },
  "__comment_exceptions": "Post-build audit (core/exceptions.py), run on the FINAL NEO/LAO rows after mapping + cross-reference enrichment. Two severities land in the same NEO_Exceptions.csv/LAO_Exceptions.csv, distinguished by the _removed_from_output column: rows flagged for a single blank critical_fields/gibberish_fields entry stay in NEO.csv/LAO.csv unchanged (a companion review view); rows where ComponentCode AND ModifierCode are BOTH blank are actually removed from NEO.csv/LAO.csv (see core/exceptions.py's split_blank_pair — hardcoded to that field pair, not configurable here, since it's the AMT-key pair specifically, not an arbitrary list).",
  "exceptions": {
    "critical_fields": [
      "AssetName",
      "SerialNumber",
      "ComponentCode",
      "ModifierCode"
    ],
    "gibberish_fields": [
      "AssetName",
      "SerialNumber",
      "ComponentCode",
      "ModifierCode"
    ]
  },
