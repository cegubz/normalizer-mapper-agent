# Copy to .env for local container runs against the Foundry gateway.
MODEL_PROVIDER=foundry
FOUNDRY_PROJECT_ENDPOINT=https://aif-schemaupd-dev-aue-001.services.ai.azure.com/api/projects/aif-schemaupd-dev-aue-proj
# Must match your Foundry *model deployment name* (deploy a GPT-5.6-tier model in the catalog):
OPENAI_MODEL=gpt-5.6-terra
OPENAI_ESCALATION_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=low
USE_LLM=true

# Output storage — use Azure Blob so Logic Apps can pick up the CSVs.
STORAGE_BACKEND=stschemaupddevaue001
OUTPUT_CONTAINER=fmg-outbound
AZURE_STORAGE_CONNECTION_STRING=https://stschemaupddevaue001.blob.core.windows.net/

# Auth for DefaultAzureCredential is provided by the hosted agent's managed identity
# in Foundry; locally use `az login` or set AZURE_CLIENT_ID/TENANT_ID/SECRET.
